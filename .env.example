DATABASE_URL=sqlite:///./actioninbox.db
# MySQL example (replace placeholders; do not commit credentials):
# DATABASE_URL=mysql+pymysql://actioninbox:change-me@mysql:3306/actioninbox?charset=utf8mb4
# Required for signed opaque session cookies. Generate at least 32 random bytes.
SESSION_SECRET=
OPENAI_API_KEY=
# Optional path inside the server/container to an additional trusted CA bundle.
OPENAI_CA_BUNDLE=
# Server-side Gmail OAuth values. Never commit real values or the downloaded JSON.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://actioninboxapp.com/auth/google/callback
# Generate separately for each environment with Fernet.generate_key().
TOKEN_ENCRYPTION_KEY=
REPOSITORY_ORIGIN=https://github.com/a0527645787-oss/action-inbox-build-week.git
# Google Sheets expense tracking (server-side Service Account only).
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/actioninbox-google-service-account.json
ACTIONINBOX_SHEET_ID=
ACTIONINBOX_SHEET_TAB=Expenses
# Keep disabled until authenticated MCP write authorization is implemented.
MCP_SHEETS_WRITE_ENABLED=false
